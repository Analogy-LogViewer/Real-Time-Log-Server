    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.339" />
    <PackageVersion Include="Meziantou.Polyfill" Version="1.0.171" />
    <PackageVersion Include="Microsoft.AspNetCore.Hosting.WindowsServices" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeStyle" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
